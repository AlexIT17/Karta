<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============ РАЗРЕШЕНИЯ ============ -->

    <!-- Доступ к камере - понадобится для сканирования QR-кода карты на кассе -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Доступ в интернет - пригодится, если позже подключишь Firebase или API -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Камера не обязательна для установки приложения -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Karta"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Karta"
        tools:targetApi="31">

        <!-- ============ ЭКРАН ВХОДА (стартовый экран приложения) ============ -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.Karta">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ============ ЭКРАН РЕГИСТРАЦИИ ============ -->
        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.Karta" />

        <!-- ============ ГЛАВНЫЙ ЭКРАН (с нижней навигацией) ============ -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.Karta" />

        <!-- ============ АДМИН-ПАНЕЛЬ (добавим позже) ============ -->
        <!--
        <activity
            android:name=".activities.AdminActivity"
            android:exported="false"
            android:theme="@style/Theme.Karta" />
        -->

        <!-- ============ ЭКРАН СКАНЕРА QR-КОДА (добавим позже) ============ -->
        <!--
        <activity
            android:name=".activities.ScanActivity"
            android:exported="false"
            android:theme="@style/Theme.Karta" />
        -->

    </application>

</manifest>